// VÉLORA — PostgreSQL schema.
//
// Conventions
// - Money: INTEGER halalas (1 SAR = 100 halalas). Never floats.
// - Time: timestamptz(3), always UTC. Display converts to Asia/Riyadh.
// - IDs: UUIDv7 (time-ordered → good index locality, not guessable/sequential).
// - Tables/columns are snake_case (@@map/@map) so hand-written SQL stays idiomatic.
// - Invariants Prisma cannot express (CHECK constraints, sequences, partial
//   indexes) live in hand-written SQL inside the migrations; see
//   docs/architecture/database.md.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleKey {
  CUSTOMER
  STAFF
  ADMIN
}

enum Permission {
  DASHBOARD_VIEW
  ORDERS_VIEW
  ORDERS_MANAGE
  ORDERS_REFUND
  PRODUCTS_VIEW
  PRODUCTS_MANAGE
  PRODUCTS_DELETE
  CATALOG_MANAGE
  INVENTORY_VIEW
  INVENTORY_ADJUST
  CUSTOMERS_VIEW
  CUSTOMERS_MANAGE
  COUPONS_MANAGE
  REVIEWS_MODERATE
  CONTENT_MANAGE
  NEWSLETTER_VIEW
  MESSAGES_VIEW
  SETTINGS_MANAGE
  ADMIN_USERS_MANAGE
  AUDIT_LOG_VIEW
  IMPORT_EXPORT
  NOTIFICATIONS_VIEW
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  WOMEN
  MEN
  UNISEX
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryKind {
  STANDARD
  GENDER
  NEW_ARRIVALS
  BEST_SELLERS
  OFFERS
}

enum ColorFamily {
  BLACK
  WHITE
  BEIGE
  BROWN
  TAN
  GREY
  NAVY
  BLUE
  GREEN
  RED
  PINK
  PURPLE
  YELLOW
  GOLD
  SILVER
  ROSE_GOLD
  MULTI
}

enum InventoryMovementType {
  INITIAL
  RESTOCK
  MANUAL_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  SALE
  CANCELLATION_RESTOCK
  RETURN_RESTOCK
  IMPORT
  DAMAGE_WRITE_OFF
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponScope {
  ALL
  PRODUCTS
  CATEGORIES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  MADA
  APPLE_PAY
  STC_PAY
  COD
}

/// Where the order's stock currently stands (see docs/architecture/inventory.md).
enum OrderInventoryStatus {
  RESERVED
  COMMITTED
  RELEASED
  RESTOCKED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_SENDER
  CANCELLED
}

enum ActorType {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ItemCondition {
  SELLABLE
  DAMAGED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum BannerPlacement {
  HERO
  PROMO
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  REJECTED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Role definitions. ADMIN implicitly holds every permission (enforced in code);
/// the STAFF permission set is editable by admins.
model Role {
  key         RoleKey      @id
  nameAr      String       @map("name_ar")
  nameEn      String       @map("name_en")
  permissions Permission[]
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       User[]

  @@map("roles")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique @db.Citext
  passwordHash      String     @map("password_hash")
  name              String
  phone             String?
  role              RoleKey    @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  locale            String     @default("ar") @db.VarChar(5)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleRef            Role                   @relation(fields: [role], references: [key])
  sessions           Session[]
  tokens             VerificationToken[]
  addresses          Address[]
  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
  reviews            Review[]               @relation("ReviewAuthor")
  moderatedReviews   Review[]               @relation("ReviewModerator")
  couponUsages       CouponUsage[]
  returnRequests     ReturnRequest[]        @relation("ReturnCustomer")
  reviewedReturns    ReturnRequest[]        @relation("ReturnReviewer")
  notifications      Notification[]
  auditLogs          AuditLog[]
  refundsCreated     Refund[]
  shipmentsCreated   Shipment[]
  inventoryMovements InventoryTransaction[]
  contactMessages    ContactMessage[]
  settingsUpdated    Setting[]
  pagesUpdated       Page[]

  @@index([role, createdAt])
  @@index([createdAt])
  @@map("users")
}

/// Server-side session. `id` is HMAC-SHA256(AUTH_SECRET, token); the raw token
/// only ever exists in the user's httpOnly cookie.
model Session {
  id         String   @id @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use email verification / password reset tokens (hash only).
model VerificationToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  tokenHash String       @unique @map("token_hash") @db.VarChar(64)
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// Saudi National Address format.
model Address {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  label            String?  @db.VarChar(40)
  fullName         String   @map("full_name") @db.VarChar(120)
  phone            String   @db.VarChar(20)
  city             String   @db.VarChar(80)
  district         String   @db.VarChar(80)
  street           String   @db.VarChar(120)
  buildingNumber   String   @map("building_number") @db.VarChar(10)
  postalCode       String   @map("postal_code") @db.VarChar(10)
  additionalNumber String?  @map("additional_number") @db.VarChar(10)
  shortAddress     String?  @map("short_address") @db.VarChar(10)
  instructions     String?  @db.VarChar(500)
  country          String   @default("SA") @db.Char(2)
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique @db.VarChar(120)
  nameAr        String   @map("name_ar") @db.VarChar(120)
  nameEn        String   @map("name_en") @db.VarChar(120)
  descriptionAr String?  @map("description_ar")
  descriptionEn String?  @map("description_en")
  logoUrl       String?  @map("logo_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// STANDARD categories form a tree and products belong to one of them.
/// GENDER / NEW_ARRIVALS / BEST_SELLERS / OFFERS are rule-based collections
/// resolved by the catalog service from product attributes.
model Category {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique @db.VarChar(120)
  nameAr           String       @map("name_ar") @db.VarChar(120)
  nameEn           String       @map("name_en") @db.VarChar(120)
  descriptionAr    String?      @map("description_ar")
  descriptionEn    String?      @map("description_en")
  imageUrl         String?      @map("image_url")
  kind             CategoryKind @default(STANDARD)
  gender           Gender?
  parentId         String?      @map("parent_id") @db.Uuid
  sortOrder        Int          @default(0) @map("sort_order")
  isActive         Boolean      @default(true) @map("is_active")
  showInNav        Boolean      @default(false) @map("show_in_nav")
  seoTitleAr       String?      @map("seo_title_ar") @db.VarChar(160)
  seoTitleEn       String?      @map("seo_title_en") @db.VarChar(160)
  seoDescriptionAr String?      @map("seo_description_ar") @db.VarChar(320)
  seoDescriptionEn String?      @map("seo_description_en") @db.VarChar(320)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent           Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]       @relation("CategoryTree")
  products         Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  sku               String        @unique @db.VarChar(64)
  slugAr            String        @unique @map("slug_ar") @db.VarChar(200)
  slugEn            String        @unique @map("slug_en") @db.VarChar(200)
  nameAr            String        @map("name_ar") @db.VarChar(200)
  nameEn            String        @map("name_en") @db.VarChar(200)
  descriptionAr     String        @default("") @map("description_ar")
  descriptionEn     String        @default("") @map("description_en")
  /// Base selling price (halalas). Variants may override.
  price             Int
  compareAtPrice    Int?          @map("compare_at_price")
  /// Unit cost (halalas). Admin-only, never sent to the storefront.
  cost              Int?
  /// Denormalised min/max effective variant price for filtering & sorting.
  minPrice          Int           @map("min_price")
  maxPrice          Int           @map("max_price")
  categoryId        String        @map("category_id") @db.Uuid
  brandId           String?       @map("brand_id") @db.Uuid
  gender            Gender        @default(UNISEX)
  materialAr        String?       @map("material_ar") @db.VarChar(200)
  materialEn        String?       @map("material_en") @db.VarChar(200)
  lengthMm          Int?          @map("length_mm")
  widthMm           Int?          @map("width_mm")
  heightMm          Int?          @map("height_mm")
  weightGrams       Int?          @map("weight_grams")
  careAr            String?       @map("care_ar")
  careEn            String?       @map("care_en")
  isFeatured        Boolean       @default(false) @map("is_featured")
  isBestseller      Boolean       @default(false) @map("is_bestseller")
  isNewArrival      Boolean       @default(false) @map("is_new_arrival")
  status            ProductStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(3)
  lowStockThreshold Int           @default(3) @map("low_stock_threshold")
  seoTitleAr        String?       @map("seo_title_ar") @db.VarChar(160)
  seoTitleEn        String?       @map("seo_title_en") @db.VarChar(160)
  seoDescriptionAr  String?       @map("seo_description_ar") @db.VarChar(320)
  seoDescriptionEn  String?       @map("seo_description_en") @db.VarChar(320)
  /// Normalised Arabic+English search document (names, SKUs, brand, category, colours).
  searchText        String        @default("") @map("search_text")
  salesCount        Int           @default(0) @map("sales_count")
  /// Average rating × 100 (e.g. 450 = 4.50) over approved reviews.
  ratingAverage     Int           @default(0) @map("rating_average")
  ratingCount       Int           @default(0) @map("rating_count")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  couponProducts CouponProduct[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, gender])
  @@index([status, minPrice])
  @@index([status, salesCount])
  @@index([status, ratingAverage])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model ProductVariant {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  sku            String       @unique @db.VarChar(64)
  barcode        String?      @unique @db.VarChar(64)
  nameAr         String       @map("name_ar") @db.VarChar(160)
  nameEn         String       @map("name_en") @db.VarChar(160)
  colorFamily    ColorFamily? @map("color_family")
  colorNameAr    String?      @map("color_name_ar") @db.VarChar(80)
  colorNameEn    String?      @map("color_name_en") @db.VarChar(80)
  colorHex       String?      @map("color_hex") @db.VarChar(7)
  size           String?      @db.VarChar(40)
  /// Overrides the product price when set (halalas).
  price          Int?
  compareAtPrice Int?         @map("compare_at_price")
  imageId        String?      @map("image_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  isDefault      Boolean      @default(false) @map("is_default")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  image         ProductImage?          @relation(fields: [imageId], references: [id], onDelete: SetNull)
  inventory     Inventory?
  movements     InventoryTransaction[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId, sortOrder])
  @@index([colorFamily])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  url        String
  storageKey String?  @map("storage_key")
  altAr      String?  @map("alt_ar") @db.VarChar(200)
  altEn      String?  @map("alt_en") @db.VarChar(200)
  width      Int?
  height     Int?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// Stock per variant. Invariants (CHECK): on_hand >= 0, 0 <= reserved <= on_hand.
/// Sellable quantity = on_hand - reserved.
model Inventory {
  variantId         String   @id @map("variant_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int?     @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// Append-only stock ledger: every change to on_hand/reserved is recorded here
/// in the same transaction as the change itself.
model InventoryTransaction {
  id               String                @id @default(uuid(7)) @db.Uuid
  variantId        String                @map("variant_id") @db.Uuid
  type             InventoryMovementType
  quantityDelta    Int                   @map("quantity_delta")
  reservedDelta    Int                   @default(0) @map("reserved_delta")
  previousOnHand   Int                   @map("previous_on_hand")
  newOnHand        Int                   @map("new_on_hand")
  previousReserved Int                   @map("previous_reserved")
  newReserved      Int                   @map("new_reserved")
  reason           String?               @db.VarChar(500)
  orderId          String?               @map("order_id") @db.Uuid
  returnRequestId  String?               @map("return_request_id") @db.Uuid
  actorType        ActorType             @map("actor_type")
  actorId          String?               @map("actor_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

/// A cart belongs to a user or to a guest token (CHECK: exactly one owner).
/// Prices are never stored here — they are always read live from the catalog.
model Cart {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  guestTokenHash String?   @unique @map("guest_token_hash") @db.VarChar(64)
  couponCode     String?   @map("coupon_code") @db.VarChar(40)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  guestTokenHash String?   @unique @map("guest_token_hash") @db.VarChar(64)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([expiresAt])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

/// PERCENTAGE: `value` is basis points (1000 = 10%). FIXED_AMOUNT: `value` is halalas.
model Coupon {
  id                String      @id @default(uuid(7)) @db.Uuid
  code              String      @unique @db.Citext
  descriptionAr     String?     @map("description_ar") @db.VarChar(300)
  descriptionEn     String?     @map("description_en") @db.VarChar(300)
  type              CouponType
  value             Int
  minOrderAmount    Int?        @map("min_order_amount")
  maxDiscountAmount Int?        @map("max_discount_amount")
  startsAt          DateTime?   @map("starts_at") @db.Timestamptz(3)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(3)
  usageLimit        Int?        @map("usage_limit")
  usageLimitPerUser Int?        @map("usage_limit_per_user")
  usedCount         Int         @default(0) @map("used_count")
  scope             CouponScope @default(ALL)
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]
  orders     Order[]

  @@map("coupons")
}

model CouponProduct {
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponUsage {
  id             String   @id @default(uuid(7)) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  discountAmount Int      @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// Monetary invariant (CHECK):
/// total = subtotal - discount_total + shipping_total + cod_fee
///         + (tax_total if prices exclude tax, else 0)
model Order {
  id                   String               @id @default(uuid(7)) @db.Uuid
  orderNumber          String               @unique @map("order_number") @db.VarChar(32)
  userId               String               @map("user_id") @db.Uuid
  status               OrderStatus          @default(PENDING)
  paymentStatus        PaymentStatus        @default(PENDING) @map("payment_status")
  paymentMethod        PaymentMethod        @map("payment_method")
  inventoryStatus      OrderInventoryStatus @default(RESERVED) @map("inventory_status")
  shippingMethod       ShippingMethod       @map("shipping_method")
  currency             String               @default("SAR") @db.Char(3)
  locale               String               @default("ar") @db.VarChar(5)
  subtotal             Int
  discountTotal        Int                  @default(0) @map("discount_total")
  shippingTotal        Int                  @default(0) @map("shipping_total")
  codFee               Int                  @default(0) @map("cod_fee")
  taxTotal             Int                  @default(0) @map("tax_total")
  total                Int
  pricesIncludeTax     Boolean              @map("prices_include_tax")
  taxRateBps           Int                  @map("tax_rate_bps")
  couponId             String?              @map("coupon_id") @db.Uuid
  couponCode           String?              @map("coupon_code") @db.VarChar(40)
  shippingName         String               @map("shipping_name") @db.VarChar(120)
  shippingPhone        String               @map("shipping_phone") @db.VarChar(20)
  shippingEmail        String               @map("shipping_email") @db.VarChar(254)
  shippingCity         String               @map("shipping_city") @db.VarChar(80)
  shippingDistrict     String               @map("shipping_district") @db.VarChar(80)
  shippingStreet       String               @map("shipping_street") @db.VarChar(120)
  shippingBuilding     String               @map("shipping_building") @db.VarChar(10)
  shippingPostalCode   String               @map("shipping_postal_code") @db.VarChar(10)
  shippingAdditionalNo String?              @map("shipping_additional_no") @db.VarChar(10)
  shippingInstructions String?              @map("shipping_instructions") @db.VarChar(500)
  shippingCountry      String               @default("SA") @map("shipping_country") @db.Char(2)
  customerNote         String?              @map("customer_note") @db.VarChar(500)
  reservationExpiresAt DateTime?            @map("reservation_expires_at") @db.Timestamptz(3)
  idempotencyKey       String?              @unique @map("idempotency_key") @db.VarChar(100)
  cancellationReason   String?              @map("cancellation_reason") @db.VarChar(500)
  cancelledBy          ActorType?           @map("cancelled_by")
  attentionReason      String?              @map("attention_reason") @db.VarChar(64)
  version              Int                  @default(0)
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  shippedAt            DateTime?            @map("shipped_at") @db.Timestamptz(3)
  deliveredAt          DateTime?            @map("delivered_at") @db.Timestamptz(3)
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  refundedAt           DateTime?            @map("refunded_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon             Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  shipments          Shipment[]
  statusHistory      OrderStatusHistory[]
  refunds            Refund[]
  returnRequests     ReturnRequest[]
  couponUsage        CouponUsage?
  inventoryMovements InventoryTransaction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  // Back-office search: substring matches on number, email and name (pg_trgm).
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_order_number_trgm_idx")
  @@index([shippingEmail(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_shipping_email_trgm_idx")
  @@index([shippingName(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_shipping_name_trgm_idx")
  @@map("orders")
}

/// Immutable purchase snapshot: names, SKU, prices and taxes as they were at
/// checkout, so later catalog edits never rewrite order history.
model OrderItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  productNameAr    String   @map("product_name_ar") @db.VarChar(200)
  productNameEn    String   @map("product_name_en") @db.VarChar(200)
  variantNameAr    String?  @map("variant_name_ar") @db.VarChar(160)
  variantNameEn    String?  @map("variant_name_en") @db.VarChar(160)
  productSlugAr    String?  @map("product_slug_ar") @db.VarChar(200)
  productSlugEn    String?  @map("product_slug_en") @db.VarChar(200)
  sku              String   @db.VarChar(64)
  imageUrl         String?  @map("image_url")
  unitPrice        Int      @map("unit_price")
  compareAtPrice   Int?     @map("compare_at_price")
  quantity         Int
  lineSubtotal     Int      @map("line_subtotal")
  discountAmount   Int      @default(0) @map("discount_amount")
  taxAmount        Int      @default(0) @map("tax_amount")
  lineTotal        Int      @map("line_total")
  returnedQuantity Int      @default(0) @map("returned_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
  reviews     Review[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// One row per payment attempt. No card data is ever stored — card entry
/// happens on the provider's hosted page.
model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @db.VarChar(32)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("SAR") @db.Char(3)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(128)
  providerStatus    String?       @map("provider_status") @db.VarChar(64)
  redirectUrl       String?       @map("redirect_url")
  failureCode       String?       @map("failure_code") @db.VarChar(64)
  failureMessage    String?       @map("failure_message") @db.VarChar(500)
  refundedAmount    Int           @default(0) @map("refunded_amount")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  failedAt          DateTime?     @map("failed_at") @db.Timestamptz(3)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds       Refund[]
  webhookEvents PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every received webhook, deduplicated by (provider, event_id). Replays and
/// retries hit the unique constraint and cannot apply twice.
model PaymentWebhookEvent {
  id                String             @id @default(uuid(7)) @db.Uuid
  provider          String             @db.VarChar(32)
  eventId           String             @map("event_id") @db.VarChar(191)
  eventType         String             @map("event_type") @db.VarChar(64)
  providerPaymentId String?            @map("provider_payment_id") @db.VarChar(128)
  paymentId         String?            @map("payment_id") @db.Uuid
  status            WebhookEventStatus @default(RECEIVED)
  payload           Json
  failureReason     String?            @map("failure_reason") @db.VarChar(500)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  returnRequestId  String?      @map("return_request_id") @db.Uuid
  amount           Int
  reason           String       @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(128)
  failureMessage   String?      @map("failure_message") @db.VarChar(500)
  createdById      String?      @map("created_by_id") @db.Uuid
  idempotencyKey   String?      @unique @map("idempotency_key") @db.VarChar(100)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Shipping & returns
// ---------------------------------------------------------------------------

model Shipment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  orderId             String         @map("order_id") @db.Uuid
  provider            String         @db.VarChar(32)
  carrier             String         @db.VarChar(64)
  service             ShippingMethod
  status              ShipmentStatus @default(PENDING)
  trackingNumber      String?        @map("tracking_number") @db.VarChar(100)
  trackingUrl         String?        @map("tracking_url")
  providerShipmentId  String?        @map("provider_shipment_id") @db.VarChar(128)
  cost                Int?
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at") @db.Timestamptz(3)
  shippedAt           DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt         DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey      String?        @unique @map("idempotency_key") @db.VarChar(100)
  createdById         String?        @map("created_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  events    ShipmentEvent[]

  @@unique([carrier, trackingNumber])
  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  shipmentId  String         @map("shipment_id") @db.Uuid
  status      ShipmentStatus
  description String?        @db.VarChar(500)
  location    String?        @db.VarChar(120)
  occurredAt  DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model ReturnRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  returnNumber String       @unique @map("return_number") @db.VarChar(32)
  orderId      String       @map("order_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  status       ReturnStatus @default(REQUESTED)
  reason       String       @db.VarChar(40)
  customerNote String?      @map("customer_note") @db.VarChar(1000)
  adminNote    String?      @map("admin_note") @db.VarChar(1000)
  reviewedById String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  receivedAt   DateTime?    @map("received_at") @db.Timestamptz(3)
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User                   @relation("ReturnCustomer", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?                  @relation("ReturnReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items              ReturnItem[]
  refunds            Refund[]
  inventoryMovements InventoryTransaction[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id                String         @id @default(uuid(7)) @db.Uuid
  returnRequestId   String         @map("return_request_id") @db.Uuid
  orderItemId       String         @map("order_item_id") @db.Uuid
  quantity          Int
  condition         ItemCondition?
  restockedQuantity Int            @default(0) @map("restocked_quantity")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id                 String       @id @default(uuid(7)) @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  orderItemId        String?      @map("order_item_id") @db.Uuid
  rating             Int
  title              String?      @db.VarChar(120)
  body               String       @db.VarChar(2000)
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  locale             String       @default("ar") @db.VarChar(5)
  moderatedById      String?      @map("moderated_by_id") @db.Uuid
  moderatedAt        DateTime?    @map("moderated_at") @db.Timestamptz(3)
  rejectionReason    String?      @map("rejection_reason") @db.VarChar(300)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User          @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  images      ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  reviewId   String   @map("review_id") @db.Uuid
  url        String
  storageKey String?  @map("storage_key")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Banner {
  id             String          @id @default(uuid(7)) @db.Uuid
  placement      BannerPlacement
  titleAr        String          @map("title_ar") @db.VarChar(160)
  titleEn        String          @map("title_en") @db.VarChar(160)
  subtitleAr     String?         @map("subtitle_ar") @db.VarChar(400)
  subtitleEn     String?         @map("subtitle_en") @db.VarChar(400)
  ctaLabelAr     String?         @map("cta_label_ar") @db.VarChar(60)
  ctaLabelEn     String?         @map("cta_label_en") @db.VarChar(60)
  linkUrl        String?         @map("link_url") @db.VarChar(500)
  imageUrl       String          @map("image_url")
  imageKey       String?         @map("image_key")
  mobileImageUrl String?         @map("mobile_image_url")
  altAr          String?         @map("alt_ar") @db.VarChar(200)
  altEn          String?         @map("alt_en") @db.VarChar(200)
  startsAt       DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?       @map("ends_at") @db.Timestamptz(3)
  isActive       Boolean         @default(true) @map("is_active")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

/// CMS pages (about, shipping, returns, privacy, terms). Markdown content,
/// rendered with a sanitising renderer (no raw HTML).
model Page {
  id               String   @id @default(uuid(7)) @db.Uuid
  slug             String   @unique @db.VarChar(80)
  titleAr          String   @map("title_ar") @db.VarChar(160)
  titleEn          String   @map("title_en") @db.VarChar(160)
  contentAr        String   @map("content_ar")
  contentEn        String   @map("content_en")
  seoTitleAr       String?  @map("seo_title_ar") @db.VarChar(160)
  seoTitleEn       String?  @map("seo_title_en") @db.VarChar(160)
  seoDescriptionAr String?  @map("seo_description_ar") @db.VarChar(320)
  seoDescriptionEn String?  @map("seo_description_en") @db.VarChar(320)
  isPublished      Boolean  @default(true) @map("is_published")
  updatedById      String?  @map("updated_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("pages")
}

model FaqItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  questionAr  String   @map("question_ar") @db.VarChar(300)
  questionEn  String   @map("question_en") @db.VarChar(300)
  answerAr    String   @map("answer_ar")
  answerEn    String   @map("answer_en")
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, sortOrder])
  @@map("faq_items")
}

model NewsletterSubscriber {
  id                   String           @id @default(uuid(7)) @db.Uuid
  email                String           @unique @db.Citext
  locale               String           @default("ar") @db.VarChar(5)
  status               SubscriberStatus @default(SUBSCRIBED)
  source               String?          @db.VarChar(40)
  unsubscribeTokenHash String           @unique @map("unsubscribe_token_hash") @db.VarChar(64)
  subscribedAt         DateTime         @default(now()) @map("subscribed_at") @db.Timestamptz(3)
  unsubscribedAt       DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  name      String               @db.VarChar(120)
  email     String               @db.VarChar(254)
  phone     String?              @db.VarChar(20)
  subject   String               @db.VarChar(160)
  message   String               @db.VarChar(5000)
  status    ContactMessageStatus @default(NEW)
  locale    String               @default("ar") @db.VarChar(5)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Notifications, events, audit
// ---------------------------------------------------------------------------

/// Delivery record per message. Only non-secret template data is kept
/// (never reset links or tokens). `status = SENT` only when the provider
/// accepted the message.
model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  outboxEventId     String?             @map("outbox_event_id") @db.Uuid
  channel           NotificationChannel
  template          String              @db.VarChar(64)
  locale            String              @default("ar") @db.VarChar(5)
  recipient         String              @db.VarChar(254)
  subject           String?             @db.VarChar(300)
  data              Json?
  status            NotificationStatus  @default(PENDING)
  provider          String              @db.VarChar(32)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(191)
  error             String?             @db.VarChar(1000)
  attempts          Int                 @default(0)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  outboxEvent OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@unique([outboxEventId, channel, template])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

/// Transactional outbox: domain events written in the same transaction as the
/// business change, processed asynchronously with retries. A failing email
/// provider can never roll back an order.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String       @db.VarChar(64)
  aggregateType String?      @map("aggregate_type") @db.VarChar(40)
  aggregateId   String?      @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8) @map("max_attempts")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  notifications Notification[]

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  action     String    @db.VarChar(64)
  entityType String    @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  requestId  String?   @map("request_id") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Restrict: the audit trail must keep its attribution (users are anonymised, never hard-deleted).
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Typed store settings stored as validated JSON documents per group
/// (store, shipping, tax, cod, checkout, seo, returns, reviews).
model Setting {
  key         String   @id @db.VarChar(40)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

model IdempotencyKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  scope          String            @db.VarChar(80)
  key            String            @db.VarChar(100)
  userId         String?           @map("user_id") @db.Uuid
  requestHash    String            @map("request_hash") @db.VarChar(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime?         @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Fixed-window counters shared by every app instance (see lib/rate-limit).
model RateLimitBucket {
  key         String   @id @db.VarChar(191)
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
