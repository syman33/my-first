# =============================================================================
# VÉLORA environment configuration template.
# Copy to `.env` for local development. NEVER commit real values.
# Server secrets must never use the NEXT_PUBLIC_ prefix (those are sent to browsers).
# Validation: src/lib/env.ts — the server refuses to start on invalid config.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Deployment environment label: development | test | staging | production.
# (Staging runs NODE_ENV=production with APP_ENV=staging.)
APP_ENV=development
# Canonical public origin. Used for canonical URLs, emails, CSRF origin checks
# and cookie security (https => Secure + __Host- cookies). Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Honour X-Forwarded-* headers (set true behind Vercel / a trusted load balancer).
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info

# --- Database (PostgreSQL 16) -----------------------------------------------------
# Use a pooled connection string on serverless hosts (Neon/Supabase pooler, PgBouncer).
DATABASE_URL=postgresql://velora:velora_dev_password@localhost:5432/velora_dev
DATABASE_POOL_MAX=10

# --- Security ----------------------------------------------------------------
# >= 32 random characters. Keys HMAC hashing of session/verification tokens and
# encryption of short-lived secrets in the outbox. Rotating it signs everyone out.
# Generate: openssl rand -base64 48
AUTH_SECRET=
# Bearer secret for /api/cron/* job endpoints (required in production, >= 32 chars).
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Payments ----------------------------------------------------------------------
# mock    = development/test simulator (refused in production unless explicitly allowed)
# moyasar = Moyasar hosted payments (mada, Visa/Mastercard, Apple Pay, STC Pay)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
# How long unpaid online orders hold stock is a store setting:
# Admin → Settings → Checkout ("Stock hold for unpaid orders").

# --- Shipping ----------------------------------------------------------------------
# manual = staff enter carrier + tracking number (production-ready, no API)
# mock   = development simulator
SHIPPING_PROVIDER=manual

# --- Notifications -------------------------------------------------------------
# console = development: messages are recorded but NOT delivered (status SKIPPED)
# resend  = Resend transactional email API
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="VÉLORA <orders@example.com>"
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# --- Storage (product & review images) --------------------------------------------
# local = public/uploads (development only; not durable on serverless hosts)
# s3    = any S3-compatible object storage (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_PROVIDER=local
# local provider only: where uploads are written (served at /uploads; not durable on serverless hosts)
UPLOAD_DIR=storage/uploads
STORAGE_BUCKET=
STORAGE_REGION=
# Custom endpoint for S3-compatible services, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL objects are served from (CDN or bucket URL). Also allow-listed for next/image + CSP.
STORAGE_PUBLIC_BASE_URL=

# --- Rate limiting -------------------------------------------------------------------
# postgres = shared across all instances (production); memory = single process (tests only)
RATE_LIMIT_PROVIDER=postgres

# --- Analytics ---------------------------------------------------------------------
# none | console | ga4 (no personal data is ever sent)
ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Safety valve --------------------------------------------------------------------
# Allows mock payment/shipping and local storage with NODE_ENV=production.
# ONLY for a non-public staging demo or local E2E runs. Never in real production.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
